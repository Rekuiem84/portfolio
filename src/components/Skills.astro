---
import SkillCard from "./SkillCard.astro";
import { skills, nextSkills } from "../data/skills";
---

<section class="mes-skills bg-primary section-padding-s" id="mes-skills">
	<h2 class="section__title uppercase" tabindex="0">Mes skills</h2>

	<div class="skills__board">
		{skills.map((skill) => <SkillCard {...skill} />)}
	</div>

	<div class="note">
		<h3>
			En plus de ma stack actuelle, j'ai prévu de me perfectionner sur les
			outils suivants&nbsp;:
		</h3>

		<ul>
			{
				nextSkills.map((skill) => (
					<li>
						<strong>{skill.title}</strong>, {skill.description}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.mes-skills {
		padding-top: 5.5rem;
		margin-bottom: 8rem;

		& .section__title {
			text-align: center;
			margin-bottom: 1em;
		}
	}
	.skills__board {
		display: flex;
		flex-wrap: wrap;
		overflow: hidden;
		border: 4px solid var(--color-accent);
		border-radius: 32px;
		text-align: center;
		box-shadow: -6px 6px 14px hsla(258, 85%, 40%, 30%);
	}
	.skills__cont {
		padding: 1.4rem;
		flex: 1 1 250px;

		& .img-cont {
			width: min(75px, 60%);
			margin-inline: auto;
		}
		.skills__title {
			font-size: var(--fs-ml);
			text-transform: capitalize;
			text-decoration: underline;
			font-weight: bold;
		}
		& p,
		& li {
			font-size: var(--fs-text);
		}
		& .skills__title + p {
			margin-top: 0.6em;
			line-height: 1.45;
		}
		& li {
			margin-top: 0.4em;
			font-weight: 300;
		}
		.skills__list-title {
			margin-top: 1.3em;
		}
	}
	.mes-skills .note {
		margin-top: 3rem;

		h3 {
			font-size: var(--fs-m);
		}
		li {
			font-size: var(--fs-text);
			margin-top: 0.5em;

			&::before {
				content: "- ";
			}

			&:first-child {
				margin-top: 1em;
			}
		}
	}
	@media (width < 992px) {
		.skills__board {
			max-width: 600px;
			margin-inline: auto;
			flex-direction: column;
		}
	}
</style>
