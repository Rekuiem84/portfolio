---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Joshua MORINI - Portfolio",
	description = "Joshua Morini, développeur fullstack",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/images/logo-jm.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,300;1,400;1,500&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<!-- Balises Open Graph -->
		<meta property="og:title" content="Joshua MORINI - Portfolio" />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content="https://rekuiem84.github.io/portfolio/images/logo-jm.png"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://rekuiem84.github.io/portfolio/" />

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Joshua MORINI - Portfolio" />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content="https://rekuiem84.github.io/portfolio/images/logo-jm.png"
		/>
		<meta property="twitter:domain" content="rekuiem84.github.io" />
		<meta
			property="twitter:url"
			content="https://rekuiem84.github.io/portfolio/"
		/>
		<ClientRouter />
	</head>
	<body>
		<slot />
		<script src="../scripts/script.js"></script>
	</body>
</html>
